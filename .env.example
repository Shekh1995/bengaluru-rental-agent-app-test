# PostgreSQL connection. The docker-compose default is shown here.
DATABASE_URL=postgresql+psycopg://rental_agent:change-this-password@postgres:5432/rental_agent

# Provider: generic or square_yards
LISTINGS_PROVIDER=square_yards

# Generic permitted source API. It must return either an array or {"listings": [...]}
LISTINGS_API_URL=https://your-domain.example/api/listings
LISTINGS_API_TOKEN=

# Square Yards public MCP provider (no token required).
# Set LISTINGS_PROVIDER=square_yards to use this adapter.
SQUARE_YARDS_LOCATION=Bengaluru
SQUARE_YARDS_BEDROOMS=1 BHK
SQUARE_YARDS_MIN_PRICE=
SQUARE_YARDS_MAX_PRICE=22000
SQUARE_YARDS_SIZE=50
SQUARE_YARDS_PAGE=1
SQUARE_YARDS_MAX_PAGES=100

# 900 seconds = 15 minutes
LISTINGS_SYNC_INTERVAL_SECONDS=900

# Optional token for POST /api/sync
SYNC_TOKEN=

# Optional Gemini rental assistant
GEMINI_API_KEY=AQ.Ab8RN6ICyklqV0iMMb3XoZT3fpYnbsZrm65z7wn6Gq4qK1iwfQ
GEMINI_MODEL=gemini-flash-latest
